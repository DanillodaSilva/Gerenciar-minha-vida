<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fundo"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="6dp"
    android:paddingEnd="16dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/aula_linha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/widget_previa_aula"
        android:textColor="@color/widget_texto"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/aula_faltas_ok"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/widget_previa_faltas"
        android:textColor="@color/widget_nivel_ok"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/aula_faltas_atencao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/widget_nivel_atencao"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/aula_faltas_perigo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/widget_nivel_perigo"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/aula_faltas_critico"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/widget_nivel_critico"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
