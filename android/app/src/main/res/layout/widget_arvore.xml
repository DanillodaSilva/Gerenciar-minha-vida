<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fundo"
    android:clipToOutline="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="12dp">

    <ImageView
        android:id="@+id/arvore_imagem"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:adjustViewBounds="true"
        android:contentDescription="@string/widget_arvore_nome"
        android:scaleType="fitCenter"
        android:src="@drawable/arvore_estagio_3" />

    <TextView
        android:id="@+id/arvore_nome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:maxLines="1"
        android:text="@string/widget_previa_estagio"
        android:textColor="@color/widget_texto"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/arvore_pct"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:maxLines="1"
        android:text="@string/widget_previa_pct"
        android:textColor="@color/widget_texto_suave"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/arvore_sequencia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:maxLines="1"
        android:text="@string/widget_previa_sequencia"
        android:textColor="@color/widget_texto_suave"
        android:textSize="12sp" />
</LinearLayout>
